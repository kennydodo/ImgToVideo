<Window x:Class="ImgToVideo.App.ClipPreviewPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip preview"
        Height="420" Width="760"
        MinHeight="300" MinWidth="520"
        Background="{StaticResource BrushWindowBackground}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TxtTitle" Text="Clip preview"
                       Foreground="{StaticResource BrushTextPrimary}"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TxtSubtitle" Text=""
                       Foreground="{StaticResource BrushTextTertiary}"
                       FontSize="11" Margin="0,2,0,8"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnRestart" Content="⟲ Restart"
                    Style="{StaticResource SecondaryButton}" Click="BtnRestart_Click"/>
            <Button x:Name="BtnPlayPause" Content="Pause"
                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnPlayPause_Click"/>
        </StackPanel>

        <Border Background="{StaticResource BrushRecessed}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1" CornerRadius="4">
            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          MediaOpened="Player_MediaOpened"
                          MediaFailed="Player_MediaFailed"
                          MediaEnded="Player_MediaEnded"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Border>
    </DockPanel>
</Window>
