<Window x:Class="ImgToVideo.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="imgtovideo_icon.ico"
        Title="ImgToVideo — Settings"
        Height="640" Width="560"
        MinHeight="520" MinWidth="480"
        Background="{StaticResource BrushWindowBackground}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SectionResetButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushAccentTint}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnResetDefaults" Content="Reset all to defaults"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Click="BtnResetDefaults_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnSave" Content="Save"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Padding="8" Margin="0,0,0,8">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Planning"/>
                            <Button Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource SectionResetButton}"
                                    Click="BtnResetPlanning_Click"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Planner" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbPlanner" Margin="0,2,12,2"/>
                        </UniformGrid>
                        <TextBlock Text="v1 = automatic scene inference from the images. v2 = visual_manifest.json / shotlist.json (the LLM edit list) drives the edit."
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Padding="8" Margin="0,0,0,8">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Image durations (seconds)"/>
                            <Button Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource SectionResetButton}"
                                    Click="BtnResetTiming_Click"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Minimum" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTimingMin" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Preferred" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTimingPreferred" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Maximum" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTimingMax" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Overflow floor" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTimingFloor" Padding="3,2" Margin="0,2,12,2"/>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Padding="8" Margin="0,0,0,8">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Motion"/>
                            <Button Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource SectionResetButton}"
                                    Click="BtnResetMotion_Click"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoMotion" Content="Automatic zoom and pan (unsuffixed images)"
                                  Margin="0,2,0,6"/>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Motion completes after (ms)" VerticalAlignment="Center"
                                       ToolTip="0 = motion runs for the whole clip. Applies to manifest-planned shots; override per shot with motion duration_ms in the shotlist."/>
                            <TextBox x:Name="TxtMotionDuration" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Easing" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbEasing" Margin="0,2,12,2"/>
                            <TextBlock Text="Push-in start %" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPushInStart" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Push-in end %" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPushInEnd" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Zoom-out start %" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtZoomOutStart" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Zoom-out end %" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtZoomOutEnd" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Pan max travel (% frame)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPanTravel" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Static every N shots (min/max)" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TxtStaticMin" Width="48" Padding="3,2" Margin="0,2,6,2"/>
                                <TextBox x:Name="TxtStaticMax" Width="48" Padding="3,2" Margin="0,2,12,2"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Padding="8" Margin="0,0,0,8">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Transitions"/>
                            <Button Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource SectionResetButton}"
                                    Click="BtnResetTransitions_Click"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <CheckBox x:Name="ChkTransitionsEnabled" Content="Transitions between clips" Margin="0,2,0,6"/>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Within scenes" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbTransitionKind" Margin="0,2,12,2"/>
                            <TextBlock Text="Between scenes" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbSceneBoundaryKind" Margin="0,2,12,2"/>
                            <TextBlock Text="Alignment" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbTransitionAlignment" Margin="0,2,12,2"/>
                            <TextBlock Text="Duration (seconds)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTransitionDuration" Padding="3,2" Margin="0,2,12,2"/>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Padding="8" Margin="0,0,0,8">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="File naming"/>
                            <Button Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource SectionResetButton}"
                                    Click="BtnResetNaming_Click"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <CheckBox x:Name="ChkTypeCodes" Content="Image type codes enabled (…_SCN_ZI — the new S##_##_TYPE_MOTION format)"
                                  Margin="0,2,0,4"/>
                        <CheckBox x:Name="ChkMotionCodes" Content="Motion codes enabled (…_ZI/_PR suffixes)"
                                  Margin="0,2,0,6"/>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Scene prefix" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtScenePrefix" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Number padding" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtNumberPadding" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Separator" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSeparator" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Extensions (comma separated)" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtExtensions" Padding="3,2" Margin="0,2,12,2"/>
                        </UniformGrid>
                        <TextBlock x:Name="TxtNamingExample" Text="Example: S08_02_SCN_PR"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Padding="8" Margin="0,0,0,8">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Output"/>
                            <Button Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource SectionResetButton}"
                                    Click="BtnResetOutput_Click"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Resolution preset" VerticalAlignment="Center"
                                       ToolTip="Picks Width/Height below. 2K (2560×1440) is the default; 4K is heavier to render."/>
                            <ComboBox x:Name="CmbResolution" Margin="0,2,12,2"
                                      SelectionChanged="CmbResolution_SelectionChanged"/>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Width" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtOutputWidth" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="Height" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtOutputHeight" Padding="3,2" Margin="0,2,12,2"/>
                            <TextBlock Text="FPS" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtOutputFps" Padding="3,2" Margin="0,2,12,2"/>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Padding="8" Margin="0,0,0,8">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Scene inference"/>
                            <Button Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource SectionResetButton}"
                                    Click="BtnResetSceneInference_Click"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Sentence gap (seconds)" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSentenceGap" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Terminal punctuation gap (seconds)" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTerminalGap" Padding="3,2" Margin="0,2,12,2"/>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Padding="8">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Render &amp; tools"/>
                            <Button Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource SectionResetButton}"
                                    Click="BtnResetRender_Click"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Preview width" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPreviewWidth" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Preview height" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPreviewHeight" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Preview preset" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPreviewPreset" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Preview CRF" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPreviewCrf" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Final preset" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtFinalPreset" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Final CRF" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtFinalCrf" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="Encoder (auto/cpu/h264_nvenc/h264_amf/h264_qsv)" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtEncoder" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="ffmpeg path" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtFfmpegPath" Padding="3,2" Margin="0,2,12,2"/>
                        <TextBlock Text="ffprobe path" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtFfprobePath" Padding="3,2" Margin="0,2,12,2"/>
                    </UniformGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
