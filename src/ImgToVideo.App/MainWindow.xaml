<Window x:Class="ImgToVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImgToVideo — Video Assembler"
        Height="680" Width="780"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="VIDEO ASSEMBLER"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Project Folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="TxtFolder" VerticalAlignment="Center"
                     Padding="4,3" TextChanged="TxtFolder_TextChanged"/>
            <Button Grid.Column="2" x:Name="BtnBrowse" Content="Browse…"
                    Padding="10,3" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,12"
                Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio:" FontWeight="SemiBold" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAudio" Text="—" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Subtitle:" FontWeight="SemiBold" Margin="24,2,8,2"/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtSubtitle" Text="—" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Images:" FontWeight="SemiBold" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtImages" Text="—" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Scenes:" FontWeight="SemiBold" Margin="24,2,8,2"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtScenes" Text="—" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration:" FontWeight="SemiBold" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDuration" Text="—" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Warnings:" FontWeight="SemiBold" Margin="24,2,8,2"/>
                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtWarningCount" Text="—" Margin="0,2"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <CheckBox x:Name="ChkAutoMotion" Content="Automatic zoom and pan"
                          IsChecked="True" Margin="0,2"/>
                <CheckBox x:Name="ChkTransitions" Content="Simple crossfades"
                          IsChecked="True" Margin="0,2"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="Min duration:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtMinDuration" Width="56" Padding="3,2" Text="2.5"/>
                <TextBlock Text="Preferred:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox x:Name="TxtPreferredDuration" Width="56" Padding="3,2" Text="5.0"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="BtnSettings" Content="Settings…"
                    Padding="10,3" HorizontalAlignment="Right" Click="BtnSettings_Click"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnAnalyze" Content="ANALYZE PROJECT"
                    Padding="10,6" Margin="0,0,6,0" Click="BtnAnalyze_Click"/>
            <Button Grid.Column="1" x:Name="BtnBuild" Content="BUILD PREVIEW"
                    Padding="10,6" Margin="0,0,6,0" IsEnabled="False" Click="BtnBuild_Click"/>
            <Button Grid.Column="2" x:Name="BtnExport" Content="EXPORT TO PREMIERE"
                    Padding="10,6" Margin="0,0,6,0" IsEnabled="False" Click="BtnExport_Click"/>
            <Button Grid.Column="3" x:Name="BtnCancel" Content="Cancel"
                    Padding="10,6" IsEnabled="False" Click="BtnCancel_Click"/>
        </Grid>

        <GroupBox Grid.Row="5" Header="Diagnostics" Padding="6">
            <ListBox x:Name="LstIssues" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>

        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready."
                       TextWrapping="Wrap" MaxHeight="64"
                       VerticalAlignment="Top"/>
            <ProgressBar x:Name="PbRender" Height="16"
                         Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
