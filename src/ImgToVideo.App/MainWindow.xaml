<Window x:Class="ImgToVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="imgtovideo_icon.ico"
        Title="ImgToVideo — Video Assembler"
        Height="680" Width="900"
        MinHeight="560" MinWidth="760"
        Background="{StaticResource BrushWindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="VIDEO ASSEMBLER"
                   Foreground="{StaticResource BrushTextPrimary}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Project Folder:"
                       Foreground="{StaticResource BrushTextLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="TxtFolder" VerticalAlignment="Center"
                     TextChanged="TxtFolder_TextChanged"/>
            <Button Grid.Column="2" x:Name="BtnBrowse" Content="Browse…"
                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1" Padding="10" Margin="0,0,0,12"
                Background="{StaticResource BrushPanel}" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio:"
                           Foreground="{StaticResource BrushTextLabel}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAudio" Text="—"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Subtitle:"
                           Foreground="{StaticResource BrushTextLabel}" Margin="24,2,8,2"/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtSubtitle" Text="—"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Images:"
                           Foreground="{StaticResource BrushTextLabel}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtImages" Text="—"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Scenes:"
                           Foreground="{StaticResource BrushTextLabel}" Margin="24,2,8,2"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtScenes" Text="—"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration:"
                           Foreground="{StaticResource BrushTextLabel}" Margin="0,2,8,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDuration" Text="—"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Warnings:"
                           Foreground="{StaticResource BrushTextLabel}" Margin="24,2,8,2"/>
                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtWarningCount" Text="—"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <CheckBox x:Name="ChkAutoMotion" Content="Automatic zoom and pan"
                          IsChecked="True" Margin="0,2"/>
                <CheckBox x:Name="ChkTransitions" Content="Simple crossfades"
                          IsChecked="True" Margin="0,2"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="Min duration:"
                           Foreground="{StaticResource BrushTextLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtMinDuration" Width="56" Text="2.5"/>
                <TextBlock Text="Preferred:"
                           Foreground="{StaticResource BrushTextLabel}"
                           VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox x:Name="TxtPreferredDuration" Width="56" Text="5.0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnScenes" Content="Scenes…"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        IsEnabled="False" Click="BtnScenes_Click"/>
                <Button x:Name="BtnSettings" Content="Settings…"
                        Style="{StaticResource SecondaryButton}" Click="BtnSettings_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnAnalyze" Content="ANALYZE"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="BtnAnalyze_Click"/>
            <Button Grid.Column="1" x:Name="BtnBuild" Content="BUILD PREVIEW"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" IsEnabled="False" Click="BtnBuild_Click"/>
            <Button Grid.Column="2" x:Name="BtnFinal" Content="RENDER FINAL"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" IsEnabled="False"
                    ToolTip="Full-resolution render to out\final\final.mp4 plus captions.srt — ready to drop into CapCut."
                    Click="BtnFinal_Click"/>
            <Button Grid.Column="3" x:Name="BtnExport" Content="EXPORT TO PREMIERE"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" IsEnabled="False" Click="BtnExport_Click"/>
            <Button Grid.Column="4" x:Name="BtnCancel" Content="Cancel"
                    Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="BtnCancel_Click"/>
        </Grid>

        <GroupBox Grid.Row="5" Header="Diagnostics">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" x:Name="BtnCopyDiagnostics" Content="COPY"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" Margin="0,0,0,4"
                        ToolTip="Copy all diagnostics to the clipboard (paste into the LLM chat to fix the shot list)."
                        Click="BtnCopyDiagnostics_Click"/>
                <ListBox Grid.Row="1" x:Name="LstIssues"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding TintBrush}"
                                CornerRadius="4" Padding="8,4" Margin="0,2">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding TextBrush}"
                                       FontFamily="Consolas" FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready."
                       Foreground="{StaticResource BrushTextPrimary}"
                       TextWrapping="Wrap" MaxHeight="64"
                       VerticalAlignment="Top"/>
            <ProgressBar x:Name="PbRender" Height="16"
                         Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
