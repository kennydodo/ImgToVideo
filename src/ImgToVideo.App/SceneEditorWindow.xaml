<Window x:Class="ImgToVideo.App.SceneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImgToVideo.App"
        Title="ImgToVideo — Scene Editor"
        Height="760" Width="1060"
        MinHeight="560" MinWidth="920"
        Background="{StaticResource BrushWindowBackground}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <x:Array x:Key="MotionChoices" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <sys:String>Auto</sys:String>
            <sys:String>ST</sys:String>
            <sys:String>ZI</sys:String>
            <sys:String>ZO</sys:String>
            <sys:String>PL</sys:String>
            <sys:String>PR</sys:String>
            <sys:String>PU</sys:String>
            <sys:String>PD</sys:String>
            <sys:String>PV</sys:String>
        </x:Array>
        <x:Array x:Key="EasingChoices" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <sys:String>Auto</sys:String>
            <sys:String>Linear</sys:String>
            <sys:String>Ease in</sys:String>
            <sys:String>Ease out</sys:String>
            <sys:String>Ease in out</sys:String>
        </x:Array>
        <x:Array x:Key="TransitionChoices" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <sys:String>Auto</sys:String>
            <sys:String>Cut</sys:String>
            <sys:String>Crossfade</sys:String>
            <sys:String>Dip to black</sys:String>
            <sys:String>Dip to white</sys:String>
            <sys:String>Wipe left</sys:String>
            <sys:String>Wipe right</sys:String>
            <sys:String>Wipe up</sys:String>
            <sys:String>Wipe down</sys:String>
            <sys:String>Slide left</sys:String>
            <sys:String>Slide right</sys:String>
            <sys:String>Dissolve</sys:String>
            <sys:String>Circle open</sys:String>
            <sys:String>Circle close</sys:String>
            <sys:String>Smooth push left</sys:String>
            <sys:String>Smooth push right</sys:String>
        </x:Array>
    </Window.Resources>

    <DockPanel Margin="12" LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Scene:"
                       Foreground="{StaticResource BrushTextLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="CmbScene"
                      SelectionChanged="CmbScene_SelectionChanged"/>
            <CheckBox Grid.Column="2" x:Name="ChkAllScenes" Content="All scenes" Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      ToolTip="Show every scene's shots in one list; PLAY SCENE then previews the whole video with your current edits."
                      Checked="ChkAllScenes_Changed" Unchecked="ChkAllScenes_Changed"/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Save overrides"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnClose" Content="Close"
                    Style="{StaticResource SecondaryButton}" IsCancel="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="TxtEditorStatus"
                   Text="Edits are saved to overrides.json and applied on the next BUILD PREVIEW."
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="110"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="1*" MinHeight="170"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Clip" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Motion" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Easing" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Frames" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Exclude" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="Transition in" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="6" Text="Nudge" FontWeight="SemiBold"/>
                </Grid>
                <ItemsControl x:Name="ClipList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Display}"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}"/>
                                <ComboBox Grid.Column="1" Margin="0,0,4,0"
                                          ItemsSource="{StaticResource MotionChoices}"
                                          SelectedItem="{Binding Motion, Mode=TwoWay}"/>
                                <ComboBox Grid.Column="2" Margin="0,0,4,0"
                                          ItemsSource="{StaticResource EasingChoices}"
                                          SelectedItem="{Binding Easing, Mode=TwoWay}"/>
                                <TextBox Grid.Column="3" Text="{Binding Duration, Mode=TwoWay}"
                                         Tag="{Binding}" TextChanged="DurationBox_TextChanged"/>
                                <CheckBox Grid.Column="4" IsChecked="{Binding Exclude, Mode=TwoWay}"
                                          Tag="{Binding}" Checked="ExcludeBox_Changed" Unchecked="ExcludeBox_Changed"
                                          HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="5" Margin="0,0,4,0"
                                          ItemsSource="{StaticResource TransitionChoices}"
                                          SelectedItem="{Binding Transition, Mode=TwoWay}"/>
                                <StackPanel Grid.Column="6" Margin="0,0,8,0"
                                            Visibility="{Binding CanNudge, Converter={StaticResource BoolToVis}}">
                                    <Slider Minimum="-120" Maximum="120"
                                            Value="{Binding Nudge, Mode=OneWay}"
                                            Tag="{Binding}" ValueChanged="NudgeSlider_ValueChanged"
                                            Thumb.DragStarted="NudgeSlider_DragStarted"
                                            Thumb.DragCompleted="NudgeSlider_DragCompleted"
                                            VerticalAlignment="Center"
                                            ToolTip="Drag to shift the cut after this clip (±120 frames); Frames boxes update live. Shifting a scene-end cut moves frames across the scene boundary."/>
                                    <TextBlock Text="{Binding NudgeLabel}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource BrushTextTertiary}"
                                               HorizontalAlignment="Center"
                                               ToolTip="{Binding NudgeLabel}"/>
                                </StackPanel>
                                <Button Grid.Column="7" Content="↑"
                                        Style="{StaticResource SecondaryButton}" Padding="2,0"
                                        Tag="{Binding}" Click="BtnMoveUp_Click"/>
                                <Button Grid.Column="8" Content="↓"
                                        Style="{StaticResource SecondaryButton}" Padding="2,0" Margin="4,0,0,0"
                                        Tag="{Binding}" Click="BtnMoveDown_Click"/>
                                <Button Grid.Column="9" Content="▶" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Padding="2,0"
                                        ToolTip="Preview this clip"
                                        Tag="{Binding}" Click="BtnPreviewRow_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource BrushBorderSubtle}"/>

        <Border Grid.Row="2"
                Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,8,10,0">
                    <Button x:Name="BtnPlayScene" Content="▶ Play scene"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Render and play the listed clips with this editor's row edits."
                            Click="BtnPlayScene_Click"/>
                    <Button x:Name="BtnPlayAll" Content="▶ Play all"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            ToolTip="Play the full BUILD PREVIEW output (out\preview.mp4). Reflects saved overrides only."
                            Click="BtnPlayAll_Click"/>
                    <Button x:Name="BtnUndock" Content="Undock"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            ToolTip="Open the current preview in a floating window"
                            Click="BtnUndock_Click"/>
                </StackPanel>
                <local:PlayerControl x:Name="PlayerHost" Margin="10,8,10,0"/>
                <Border Background="{StaticResource BrushRecessed}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="4" Padding="6" Margin="10,8,10,10">
                    <StackPanel>
                        <Grid x:Name="StripGrid" Height="36" MinHeight="36"/>
                        <TextBlock FontSize="10.5" Margin="0,4,0,0"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   Text="Timeline strip — each block is one shot, sized by its frames. Drag the handle between blocks to move the cut; the accent outline follows playback."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
